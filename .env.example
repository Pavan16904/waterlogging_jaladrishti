# ==============================================================================
#  JalaDrishti AI - Karnataka Waterlogging & Flood Intelligence Platform
#  Root Environment Configuration Template
#  Copy this file to .env and fill in real credentials.
#  NEVER commit your actual .env file or expose secrets in client bundles.
# ==============================================================================

# ------------------------------------------------------------------------------
# Core Databases & Caching
# ------------------------------------------------------------------------------
# PostgreSQL 18 with PostGIS connection string
# Format: postgresql://<user>:<password>@<host>:<port>/<database>
DATABASE_URL=postgresql://postgres:your_postgres_password@localhost:5432/waterlogging_db

# Redis connection string for high-speed snapshot caching and pub/sub
# Format: redis://<host>:<port> or rediss:// for TLS
REDIS_URL=redis://localhost:6379

# Server port for Express API Gateway
PORT=5000
NODE_ENV=development

# ------------------------------------------------------------------------------
# Weather & NWP Models
# ------------------------------------------------------------------------------
# Open-Meteo API Key
# Optional: Open-Meteo free tier requires NO key for non-commercial use (<10,000 req/day).
# Issuing Authority: Open-Meteo GmbH (https://open-meteo.com/en/pricing)
OPEN_METEO_API_KEY=

# ------------------------------------------------------------------------------
# Earth Observation & Satellite Radar
# ------------------------------------------------------------------------------
# Copernicus Data Space Ecosystem (CDSE) - Sentinel-1 SAR & Sentinel-2 Optical
# Required for Sentinel-1 synthetic aperture radar flood extent mapping.
# Issuing Authority: European Space Agency / Copernicus Data Space (https://dataspace.copernicus.eu)
CDSE_USERNAME=
CDSE_PASSWORD=

# NASA Earthdata Login - GPM IMERG Early Run Satellite Precipitation
# Required for satellite precipitation estimation (~4 h latency).
# Issuing Authority: NASA EOSDIS Earthdata (https://urs.earthdata.nasa.gov)
EARTHDATA_USERNAME=
EARTHDATA_TOKEN=

# ------------------------------------------------------------------------------
# Hydro-Meteorological & River Gauges (Government Portals)
# ------------------------------------------------------------------------------
# India-WRIS / CWC River Level Gauges (Tungabhadra Basin telemetry)
# Required for real-time river stage, warning & danger levels.
# Issuing Authority: Central Water Commission / Ministry of Jal Shakti (https://indiawris.gov.in)
INDIA_WRIS_API_KEY=

# Karnataka State Natural Disaster Monitoring Centre (KSNDMC) Telemetry Rain Gauges
# Required for state telemetric rain gauge network across all 31 Karnataka districts.
# Issuing Authority: KSNDMC, Government of Karnataka (https://ksndmc.karnataka.gov.in)
KSNDMC_API_KEY=

# India Meteorological Department (IMD) Observational Surface Stations
# Required for IMD AWS/ARG surface observational rainfall data.
# Issuing Authority: India Meteorological Department / MoES (https://mausam.imd.gov.in)
IMD_API_KEY=

# ------------------------------------------------------------------------------
# IoT Telemetry & Edge Sensors
# ------------------------------------------------------------------------------
# MQTT Broker for IoT Water Level & Drainage Telemetry
# Required for live ultrasonic/pressure water level sensor nodes.
# Issuing Authority: Local IoT broker or cloud provider (e.g., HiveMQ, EMQX, AWS IoT Core)
MQTT_URL=
MQTT_USERNAME=
MQTT_PASSWORD=
