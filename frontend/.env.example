# --------------------------------------------------
#  JalaDrishti Frontend -- Environment Variables
#  Copy this file to .env.local and fill in real values.
# --------------------------------------------------

# Backend API base URL (no trailing slash)
VITE_API_BASE_URL=http://localhost:5000/api

# Google Maps Platform API key (Maps JavaScript & Raster Tiles)
# Used for Flood Map basemaps: Street, Satellite, Hybrid, and Terrain.
# Required referrer restrictions for local development:
#   http://localhost:3000/*
#   http://localhost:3001/*
# Issuing Authority: Google Cloud Console (https://console.cloud.google.com/google/maps-apis/credentials)
VITE_GOOGLE_MAPS_API_KEY=

# Optional Esri World Imagery key used by the Flood Map satellite basemap.
# Without a key, satellite selection falls back to OpenStreetMap with a notice.
VITE_ESRI_API_KEY=

