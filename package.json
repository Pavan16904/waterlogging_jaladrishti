{
  "name": "waterlogging-project-root",
  "version": "2.0.0",
  "description": "AI-Based Waterlogging Detection and Drainage Advisory System Using Multi-Source Satellite Imagery",
  "scripts": {
    "live": "start_live.bat",
    "status": "node scripts/status.mjs",
    "stop": "node scripts/stop.mjs",
    "dev": "node scripts/runner.mjs",
    "start": "node scripts/runner.mjs",
    "pm2:start": "npx pm2 start ecosystem.config.cjs",
    "pm2:stop": "npx pm2 stop all",
    "pm2:status": "npx pm2 status",
    "ml": "python -m uvicorn main:app --app-dir ml_service --port 8000",
    "backend": "npm --prefix backend run dev",
    "frontend": "npm --prefix frontend run dev",
    "train": "python ml_service/train_model.py",
    "seed": "cd backend && npm run seed",
    "build": "cd backend && npm run build && cd ../frontend && npm run build"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "pm2": "^7.1.0"
  }
}
